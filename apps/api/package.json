{
  "name": "@paraiso/api",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "start:dev": "tsx watch src/main.ts",
    "build": "tsc -p tsconfig.json",
    "prisma:generate": "node scripts/prepare-prisma.cjs && prisma generate",
    "prisma:push": "node scripts/prepare-prisma.cjs && prisma db push",
    "prisma:migrate": "node scripts/prepare-prisma.cjs && prisma migrate dev",
    "prisma:seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@nestjs/common": "^11.1.6",
    "@nestjs/config": "^4.0.2",
    "@nestjs/core": "^11.1.6",
    "@nestjs/jwt": "^11.0.0",
    "@nestjs/platform-express": "^11.1.6",
    "@prisma/client": "^6.19.3",
    "bcryptjs": "^3.0.2",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.2",
    "helmet": "^8.1.0",
    "lodash": "^4.17.21",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2"
  },
  "devDependencies": {
    "@types/express": "^5.0.3",
    "@types/multer": "^2.0.0",
    "@types/node": "^24.5.2",
    "prisma": "6.19.3",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2"
  }
}
