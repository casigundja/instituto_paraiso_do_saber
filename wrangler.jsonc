{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "institutoparaisodosaber",
  "main": "scripts/cloudflare-worker.mjs",
  "compatibility_date": "2026-09-23",
  "workers_dev": true,
  "observability": {
    "enabled": true
  },
  "routes": [
    {
      "pattern": "institutoparaisodosaber.com",
      "custom_domain": true
    },
    {
      "pattern": "www.institutoparaisodosaber.com",
      "custom_domain": true
    }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "paraiso-saber-db",
      "database_id": "3cfc5597-d9ed-474d-9040-e785960e2b96"
    }
  ],
  "r2_buckets": [
    {
      "binding": "ASSETS_R2",
      "bucket_name": "paraiso-saber-assets"
    }
  ],
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/uploads/*"]
  }
}
