{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "institutoparaisodosaber",
  "main": "scripts/cloudflare-worker.mjs",
  "compatibility_date": "2026-09-23",
  "workers_dev": true,
  "observability": {
    "enabled": true
  },
  "routes": [
    {
      "pattern": "institutoparaisodosaber.com",
      "custom_domain": true
    },
    {
      "pattern": "www.institutoparaisodosaber.com",
      "custom_domain": true
    }
  ],
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  }
}
